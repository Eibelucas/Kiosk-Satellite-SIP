{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "kiosk-satellite-sip-native-lab",
  "name": "SIP Native Dialer Lab",
  "version": "26.10.13-lab.2",
  "minAndroidSdk": 24,
  "entryClass": "de.eibelucas.kiosksip.nativephone.NativePhonePlugin",
  "description": "Experimenteller nativer Telefonknopf mit ausklappbarem Dialer und direktem SIP-Anruf �ber Asterisk-Nebenstelle 100.",
  "author": "Eibelucas",
  "license": "Apache-2.0",
  "capabilities": [
    "overlay",
    "host.read",
    "host.control"
  ],
  "settings": [
    {
      "key": "server",
      "title": "HAOS-IP / Asterisk",
      "type": "string",
      "default": "",
      "group": "Telefon 100",
      "description": "Lokale IPv4-Adresse des bestehenden HAOS-Add-ons. Keine SIP-Anbieter-Zugangsdaten."
    },
    {
      "key": "port",
      "title": "Asterisk SIP-Port",
      "type": "string",
      "default": "5070",
      "group": "Telefon 100"
    },
    {
      "key": "password",
      "title": "SIP-Passwort von Telefon 100",
      "type": "secret",
      "default": "",
      "group": "Telefon 100",
      "description": "Das lokale Telefon-Passwort aus der HA-Einrichtung. Nicht das Anbieter- oder Web-Passwort."
    },
    {
      "key": "localPort",
      "title": "Lokaler SIP-Port",
      "type": "string",
      "default": "5090",
      "group": "Erweitert"
    },
    {
      "key": "side",
      "title": "Bildschirmseite",
      "type": "select",
      "default": "right",
      "options": [
        "right",
        "left"
      ],
      "group": "Telefonknopf"
    },
    {
      "key": "bottomOffset",
      "title": "Abstand vom unteren Rand (dp)",
      "type": "string",
      "default": "88",
      "group": "Telefonknopf",
      "description": "Platz f�r die Navbar lassen. 12 bis 300."
    }
  ],
  "commands": [
    {
      "id": "toggleDialer",
      "title": "Telefonknopf umschalten"
    },
    {
      "id": "openPhone",
      "title": "Nativen Dialer �ffnen"
    },
    {
      "id": "hangup",
      "title": "Gespr�ch beenden"
    }
  ]
}
