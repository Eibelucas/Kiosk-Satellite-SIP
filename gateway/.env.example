PORT=8088

# Asterisk Manager Interface. Keep AMI on the trusted LAN only.
AMI_HOST=192.168.1.20
AMI_PORT=5038
AMI_USERNAME=kioskphone
AMI_SECRET=change-me

# This channel will eventually be the SIP/media bridge endpoint used by Kiosk Satellite SIP.
ASTERISK_CHANNEL=PJSIP/kiosk-sip-bridge
ASTERISK_CONTEXT=from-kiosk-phone
ASTERISK_CALLER_ID=Kiosk Satellite <100>
